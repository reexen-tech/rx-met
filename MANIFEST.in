# Include documentation
include README.md
include LICENSE
include VERSION
include requirements.txt
include requirements-build.txt

# Include rx-met's AIMET native source for source distributions
recursive-include native/aimet *
include scripts/build_aimet_native.sh

# Include all JSON config files
recursive-include aimet_common *.json
recursive-include aimet_onnx *.json
recursive-include aimet_torch *.json

# Include all Python stub files
recursive-include aimet_common *.pyi
recursive-include aimet_onnx *.pyi
recursive-include aimet_torch *.pyi

# Include binary files if any
recursive-include aimet_common *.so *.pyd *.dll
recursive-include aimet_onnx *.so *.pyd *.dll
recursive-include aimet_torch *.so *.pyd *.dll

# Include bin directory
recursive-include aimet_common/bin *

# Exclude compiled Python files
global-exclude __pycache__
global-exclude *.py[co]
