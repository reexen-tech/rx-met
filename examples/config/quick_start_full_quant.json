{
  "description": "Demo 通用全开量化配置：默认所有算子启用 8bit 量化，仅对整数 size/index 类算子（FloorDivide/Pad）一刀切禁用；GRU_config 给 QuantGRU 内部各门写明位宽与 granularity",
  "comment": "本配置不引用任何模型特定的 layer name，复用到不同 MRNN 变体均可工作。如需对模型中的 EPS 加法 / 标量 size 乘法这类无意义量化点做精细 disable，请在 layer_name_config 中按需追加 wildcard，比如 *.cln.module_add_* / module_floordiv* 等；这些孤儿 quantizer 即使 NOT_INITIALIZED 通常也不阻断 forward，配合 step14 的兜底 compute_encodings 即可",

  "default_bitwidth": {
    "weight": 8,
    "output": 8
  },

  "layer_type_config": {
    "QuantizedConv2d": {
      "weight_bitwidth": 8,
      "bias_bitwidth": 16,
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false,
      "comment": "Conv2d 8bit weight + 16bit bias"
    },
    "QuantizedConvTranspose2d": {
      "weight_bitwidth": 8,
      "bias_bitwidth": 16,
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedLinear": {
      "weight_bitwidth": 8,
      "bias_bitwidth": 16,
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "per_channel_quantization": true,
      "disable_quantization": false
    },
    "QuantizedBatchNorm2d": {
      "weight_bitwidth": 8,
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedTanh": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedSigmoid": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedAdd": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedMultiply": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedSubtract": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedDivide": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedPow": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedSqrt": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedMean": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedVar": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedConcat": {
      "output_bitwidth": 8,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedAbs": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedSign": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedClip": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    },
    "QuantizedFloorDivide": {
      "disable_quantization": true,
      "comment": "整数 size / index 类计算，量化无意义"
    },
    "QuantizedPad": {
      "disable_quantization": true,
      "comment": "padding 常量索引，量化无意义"
    },
    "QuantizedUnfold": {
      "disable_quantization": true,
      "comment": "SpeechFeatures 分帧（tf.signal.frame），滑窗取数不是计算"
    },
    "QuantizedMatMul": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false,
      "comment": "RDFT / Mel / DCT / attention Dot"
    },
    "QuantizedLog": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false,
      "comment": "SpeechFeatures log(max(x, eps))"
    },
    "QuantizedClamp": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false,
      "comment": "log 前的 epsilon 下限"
    },
    "QuantizedSoftmax": {
      "input_bitwidth": 8,
      "output_bitwidth": 8,
      "input_symmetric": true,
      "output_symmetric": true,
      "disable_quantization": false
    }
  },

  "layer_name_config": {
    "_comment": "默认空。需要为模型中的 EPS 加法 / 标量 size 乘法做精细 disable 时，可在此追加 wildcard，比如：'*.cln.module_add_*': {disable_quantization: true}, 'module_floordiv*': {disable_quantization: true} 等"
  },

  "GRU_config": {
    "default_config": {
      "disable_quantization": false,
      "use_pot2_scale": true,
      "comment": "启用 QuantGRU 量化开关; 使用 POT2 scale 编码开关"
    },
    "operator_config": {
      "input": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "comment": "输入序列 input, 每个时间步的输入特征"
      },
      "output": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "comment": "隐藏状态 output, 每个时间步的输出，同时作为下一时间步的输入"
      },
      "weight_ih": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "quantization_granularity": "PER_CHANNEL",
        "comment": "输入权重矩阵 weight_ih, 包含 weight_ih_z/weight_ih_r/weight_ih_n 三个门的权重。quantization_granularity: PER_TENSOR(整个tensor一个scale) / PER_GATE(每个门一个scale) / PER_CHANNEL(每个输出通道一个scale, 默认)"
      },
      "weight_hh": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "quantization_granularity": "PER_CHANNEL",
        "comment": "循环权重矩阵 weight_hh, 包含 weight_hh_z/weight_hh_r/weight_hh_n 三个门的权重。quantization_granularity: PER_TENSOR / PER_GATE / PER_CHANNEL(默认)"
      },
      "bias_ih": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "quantization_granularity": "PER_CHANNEL",
        "comment": "输入偏置 bias_ih, 包含 bias_ih_z/bias_ih_r/bias_ih_n 三个门的偏置。quantization_granularity: PER_TENSOR / PER_GATE / PER_CHANNEL(默认)"
      },
      "bias_hh": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "quantization_granularity": "PER_CHANNEL",
        "comment": "循环偏置 bias_hh, 包含 bias_hh_z/bias_hh_r/bias_hh_n 三个门的偏置。quantization_granularity: PER_TENSOR / PER_GATE / PER_CHANNEL(默认)"
      },
      "weight_ih_linear": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "comment": "输入 Linear 变换输出: W*x + bw, GEMM+bias 融合结果，循环外一次性计算所有时间步"
      },
      "weight_hh_linear": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "comment": "隐状态 Linear 变换输出: R*h + br, GEMM+bias 融合结果，每个时间步计算一次"
      },
      "update_gate_input": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "comment": "更新门(z)激活前: weight_ih_linear_z + weight_hh_linear_z, sigmoid 函数的输入"
      },
      "update_gate_output": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": true,
        "comment": "更新门(z)激活后: sigmoid(update_gate_input), 范围[0,1], 控制保留多少旧状态, 使用 UINT 充分利用量化范围"
      },
      "reset_gate_input": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "comment": "重置门(r)激活前: weight_ih_linear_r + weight_hh_linear_r, sigmoid 函数的输入"
      },
      "reset_gate_output": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": true,
        "comment": "重置门(r)激活后: sigmoid(reset_gate_input), 范围[0,1], 控制遗忘多少旧状态, 使用 UINT 充分利用量化范围"
      },
      "new_gate_input": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "comment": "候选门(n)激活前: weight_ih_linear_n + mul_reset_hidden, tanh 函数的输入"
      },
      "new_gate_output": {
        "bitwidth": 8,
        "is_symmetric": true,
        "is_unsigned": false,
        "comment": "候选门(n)激活后: tanh(new_gate_input), 范围[-1,1], 候选隐藏状态, 使用 INT 对称量化"
      }
    }
  },

  "default_config": {
    "disable_quantization": false,
    "comment": "默认全开量化。这里是 v2 工具决策的最低优先级开关"
  }
}
