ARG DEVEL_IMAGE=scratch
ARG BASE_IMAGE=scratch
FROM ${DEVEL_IMAGE} AS build-env
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_VARIANT
ARG ENV_VERSION
ARG ENV_CONFIG_SHA256
ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LIBRARY_PATH=/usr/local/cuda/lib64/stubs \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10
WORKDIR /opt/rx-quant-env
RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
       build-essential ca-certificates cmake curl diffutils libeigen3-dev libgomp1 ninja-build python3-dev python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && if [[ "${CUDA_VARIANT}" != cpu ]]; then ln -sf libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1; fi
COPY . /opt/rx-quant-env/
RUN python3 scripts/environment/common.py download "${CUDA_VARIANT}" --output-dir /opt/rx-quant-env/wheelhouse \
    && cd wheelhouse && sha256sum --check --strict SHA256SUMS \
    && python3 -m pip install --ignore-installed --no-index --no-deps --find-links=. \
       -r ../requirements/build.lock -r ../requirements/runtime.lock \
    && python3 -m pip check
RUN CUDA_VARIANT="${CUDA_VARIANT}" python3 - <<'PY'
import json,os,subprocess
from pathlib import Path
spec=json.loads(Path('docker/variants.json').read_text())['variants'][os.environ['CUDA_VARIANT']]
subprocess.run(['scripts/internal/prepare_onnxruntime_headers.sh',next(iter(spec['onnxruntime']['packages'].values())),
                '/opt/rx-quant-env/onnxruntime',spec['onnxruntime']['source_sha256']],check=True)
PY
RUN python3 - <<'PY'
from pathlib import Path
import site
for root in map(Path,site.getsitepackages()):
    for header in (root/'nvidia/cudnn/include').glob('cudnn*.h'):
        target=Path('/usr/local/cuda/include')/header.name
        target.unlink(missing_ok=True)
        target.symlink_to(header)
PY
RUN CUDA_VARIANT="${CUDA_VARIANT}" ENV_CONFIG_SHA256="${ENV_CONFIG_SHA256}" python3 - <<'PY'
import json,os
from pathlib import Path
matrix=json.loads(Path('docker/variants.json').read_text());variant=os.environ['CUDA_VARIANT'];spec=matrix['variants'][variant]
values={'environment_name':matrix['environment_name'],'environment_role':'build','environment_version':matrix['environment_version'],
        'config_sha256':os.environ['ENV_CONFIG_SHA256'],'cuda_variant':variant,'cuda_version':spec['cuda_version'],
        'torch_version':spec['torch']['packages']['torch'].split('+')[0], 'onnxruntime_version':next(iter(spec['onnxruntime']['packages'].values())),
        'python_version':spec['python_version']}
Path('environment.env').write_text(''.join(f'{key}={value}\n' for key,value in values.items()))
PY
LABEL com.reexen.rx-quant.environment.name="rx-quant-env" \
      com.reexen.rx-quant.environment.role="build" \
      com.reexen.rx-quant.environment.version="${ENV_VERSION}" \
      com.reexen.rx-quant.environment.config-sha256="${ENV_CONFIG_SHA256}" \
      com.reexen.rx-quant.cuda.variant="${CUDA_VARIANT}" \
      com.reexen.rx-quant.platform.variant="${CUDA_VARIANT}"

FROM ${BASE_IMAGE} AS runtime-env
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_VARIANT
ARG ENV_VERSION
ARG ENV_CONFIG_SHA256
ENV PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends ca-certificates libgomp1 python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build-env /opt/rx-quant-env/requirements/runtime.lock /opt/rx-quant-env/requirements/runtime.lock
COPY --from=build-env /opt/rx-quant-env/environment.env /opt/rx-quant-env/environment.env
RUN --mount=from=build-env,source=/opt/rx-quant-env/wheelhouse,target=/tmp/wheelhouse,ro \
    cd /tmp/wheelhouse && sha256sum --check --strict SHA256SUMS \
    && python3 -m pip install --ignore-installed --no-index --no-deps --find-links=. \
       -r /opt/rx-quant-env/requirements/runtime.lock \
    && python3 -m pip check \
    && sed -i 's/environment_role=build/environment_role=runtime/' /opt/rx-quant-env/environment.env
RUN python3 - <<'PY'
from pathlib import Path
import site
paths=[]
for root in map(Path,site.getsitepackages()):
    paths.extend(str(p) for p in sorted((root/'nvidia').glob('*/lib')) if p.is_dir())
    if (root/'torch/lib').is_dir(): paths.append(str(root/'torch/lib'))
Path('/etc/ld.so.conf.d/rx-quant-python-cuda.conf').write_text('\n'.join(paths)+'\n')
PY
RUN ldconfig \
    && python3 -m pip freeze --all > /opt/rx-quant-env/pip-freeze.txt \
    && dpkg-query --show > /opt/rx-quant-env/dpkg-packages.txt
LABEL com.reexen.rx-quant.environment.name="rx-quant-env" \
      com.reexen.rx-quant.environment.role="runtime" \
      com.reexen.rx-quant.environment.version="${ENV_VERSION}" \
      com.reexen.rx-quant.environment.config-sha256="${ENV_CONFIG_SHA256}" \
      com.reexen.rx-quant.cuda.variant="${CUDA_VARIANT}" \
      com.reexen.rx-quant.platform.variant="${CUDA_VARIANT}"
WORKDIR /workspace
CMD ["bash"]
