ARG DEVEL_IMAGE=scratch
ARG BASE_IMAGE=scratch

FROM ${DEVEL_IMAGE} AS build-env

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_VARIANT
ARG RX_MET_CUDA_VERSION
ARG RX_MET_CUDA_ARCHITECTURES
ARG TORCH_CUDA_ARCH_LIST
ARG TORCH_VERSION
ARG TORCHVISION_VERSION
ARG TORCHAUDIO_VERSION
ARG ONNXRUNTIME_VERSION
ARG ONNXRUNTIME_SOURCE_SHA256
ARG PYTHON_VERSION
ARG ENV_VERSION

ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LIBRARY_PATH=/usr/local/cuda/lib64/stubs \
    RX_MET_ENABLE_CUDA=1 \
    RX_MET_PYTHON=python3 \
    RX_MET_ONNXRUNTIME_VERSION=${ONNXRUNTIME_VERSION} \
    RX_MET_ONNXRUNTIME_ROOT=/opt/rx-met-env/onnxruntime \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

WORKDIR /opt/rx-met-env

RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        diffutils \
        libeigen3-dev \
        libgomp1 \
        ninja-build \
        python3-dev \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN [[ "${CUDA_VARIANT}" =~ ^cu(118|126|130)$ ]] \
    && [[ -n "${RX_MET_CUDA_VERSION}" ]] \
    && [[ -n "${RX_MET_CUDA_ARCHITECTURES}" ]] \
    && [[ -n "${TORCH_CUDA_ARCH_LIST}" ]] \
    && [[ -n "${ONNXRUNTIME_SOURCE_SHA256}" ]]

COPY docker/requirements /opt/rx-met-env/docker/requirements
COPY docker/variants.json docker/docker-bake.hcl /opt/rx-met-env/docker/
COPY VERSION pyproject.toml /opt/rx-met-env/
COPY scripts/dependencies.py /opt/rx-met-env/scripts/dependencies.py
COPY scripts/internal/verify_dependency_wheelhouse.py /opt/rx-met-env/scripts/internal/verify_dependency_wheelhouse.py
COPY scripts/internal/prepare_onnxruntime_headers.sh /opt/rx-met-env/scripts/internal/prepare_onnxruntime_headers.sh
COPY native/third_party/onnxruntime /opt/rx-met-env/native/third_party/onnxruntime

RUN python3 scripts/dependencies.py check

RUN ./scripts/internal/prepare_onnxruntime_headers.sh \
        "${ONNXRUNTIME_VERSION}" "${RX_MET_ONNXRUNTIME_ROOT}" \
        "${ONNXRUNTIME_SOURCE_SHA256}"

RUN mkdir -p /opt/rx-met-env/wheelhouse \
    && python3 scripts/dependencies.py download \
        --variant "${CUDA_VARIANT}" \
        --output /opt/rx-met-env/wheelhouse \
    && cd /opt/rx-met-env/wheelhouse \
    && sha256sum --check --strict SHA256SUMS \
    && python3 -m pip install \
        --ignore-installed \
        --no-index \
        --find-links=/opt/rx-met-env/wheelhouse \
        -r /opt/rx-met-env/docker/requirements/build.lock \
    && python3 -m pip install \
        --no-index \
        --find-links=/opt/rx-met-env/wheelhouse \
        -r "/opt/rx-met-env/docker/requirements/${CUDA_VARIANT}-py${PYTHON_VERSION//./}.lock" \
    && python3 -m pip check

# AIMET ONNX Runtime headers include cudnn.h. Use the headers from the exact
# cuDNN wheel selected by the PyTorch dependency lock.
RUN python3 - <<'PY'
from pathlib import Path
import site

target = Path("/usr/local/cuda/include")
roots = [Path(value) for value in site.getsitepackages()]
headers = sorted(
    header
    for root in roots
    for header in (root / "nvidia" / "cudnn" / "include").glob("cudnn*.h")
)
if not headers:
    raise SystemExit(f"没有找到 PyTorch cuDNN headers: {roots}")
if not target.is_dir():
    raise SystemExit(f"CUDA include 目录不存在: {target}")
for header in headers:
    destination = target / header.name
    if destination.exists() or destination.is_symlink():
        destination.unlink()
    destination.symlink_to(header)
print(f"已注册 {len(headers)} 个 cuDNN headers")
PY

RUN EXPECTED_TORCH="${TORCH_VERSION}" \
    EXPECTED_TORCHVISION="${TORCHVISION_VERSION}" \
    EXPECTED_TORCHAUDIO="${TORCHAUDIO_VERSION}" \
    EXPECTED_ONNXRUNTIME="${ONNXRUNTIME_VERSION}" \
    EXPECTED_CUDA="${RX_MET_CUDA_VERSION}" \
    EXPECTED_PYTHON="${PYTHON_VERSION}" \
    python3 - <<'PY'
import importlib.metadata
import os
import sys
import onnxruntime
import torch

for package, expected in {
    "torch": os.environ["EXPECTED_TORCH"],
    "torchvision": os.environ["EXPECTED_TORCHVISION"],
    "torchaudio": os.environ["EXPECTED_TORCHAUDIO"],
}.items():
    actual = importlib.metadata.version(package).split("+", 1)[0]
    assert actual == expected, (package, actual, expected)
assert torch.version.cuda == os.environ["EXPECTED_CUDA"], torch.version.cuda
assert importlib.metadata.version("onnxruntime-gpu") == os.environ["EXPECTED_ONNXRUNTIME"]
assert "CUDAExecutionProvider" in onnxruntime.get_available_providers()
assert f"{sys.version_info.major}.{sys.version_info.minor}" == os.environ["EXPECTED_PYTHON"]
PY

RUN printf '%s\n' \
        "environment_role=build" \
        "environment_version=${ENV_VERSION}" \
        "cuda_variant=${CUDA_VARIANT}" \
        "cuda_version=${RX_MET_CUDA_VERSION}" \
        "torch_version=${TORCH_VERSION}" \
        "onnxruntime_version=${ONNXRUNTIME_VERSION}" \
        "python_version=${PYTHON_VERSION}" \
        > /opt/rx-met-env/environment.env

LABEL org.opencontainers.image.vendor="Reexen" \
      org.opencontainers.image.description="rx-met stable build environment" \
      com.reexen.rx-met.environment.role="build" \
      com.reexen.rx-met.environment.version="${ENV_VERSION}" \
      com.reexen.rx-met.cuda.variant="${CUDA_VARIANT}" \
      com.reexen.rx-met.cuda.version="${RX_MET_CUDA_VERSION}" \
      com.reexen.rx-met.torch.version="${TORCH_VERSION}" \
      com.reexen.rx-met.onnxruntime.version="${ONNXRUNTIME_VERSION}" \
      com.reexen.rx-met.python.version="${PYTHON_VERSION}"


FROM ${BASE_IMAGE} AS runtime-env

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_VARIANT
ARG RX_MET_CUDA_VERSION
ARG TORCH_VERSION
ARG TORCHVISION_VERSION
ARG TORCHAUDIO_VERSION
ARG ONNXRUNTIME_VERSION
ARG PYTHON_VERSION
ARG ENV_VERSION

ENV CUDA_VARIANT=${CUDA_VARIANT} \
    RX_MET_CUDA_VERSION=${RX_MET_CUDA_VERSION} \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /workspace

RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        ca-certificates \
        libgomp1 \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build-env /opt/rx-met-env/wheelhouse /tmp/wheelhouse
COPY --from=build-env /opt/rx-met-env/docker/requirements /opt/rx-met-env/requirements

RUN cd /tmp/wheelhouse \
    && sha256sum --check --strict SHA256SUMS \
    && python3 -m pip install \
        --no-cache-dir \
        --ignore-installed \
        --no-index \
        --no-deps \
        /tmp/wheelhouse/*.whl \
    && python3 -m pip check \
    && rm -rf /tmp/wheelhouse

RUN python3 - <<'PY' > /etc/ld.so.conf.d/rx-met-python-cuda.conf
from pathlib import Path
import site

site_roots = [Path(value) for value in site.getsitepackages()]
library_roots = sorted(
    root
    for site_root in site_roots
    for root in (site_root / "nvidia").glob("*/lib")
)
library_roots.extend(site_root / "torch" / "lib" for site_root in site_roots)
for root in library_roots:
    if root.is_dir():
        print(root)
PY
RUN ldconfig

RUN EXPECTED_TORCH="${TORCH_VERSION}" \
    EXPECTED_TORCHVISION="${TORCHVISION_VERSION}" \
    EXPECTED_TORCHAUDIO="${TORCHAUDIO_VERSION}" \
    EXPECTED_ONNXRUNTIME="${ONNXRUNTIME_VERSION}" \
    EXPECTED_CUDA="${RX_MET_CUDA_VERSION}" \
    EXPECTED_PYTHON="${PYTHON_VERSION}" \
    python3 - <<'PY'
import importlib.metadata
import os
import sys
import onnxruntime
import torch

for package, expected in {
    "torch": os.environ["EXPECTED_TORCH"],
    "torchvision": os.environ["EXPECTED_TORCHVISION"],
    "torchaudio": os.environ["EXPECTED_TORCHAUDIO"],
}.items():
    actual = importlib.metadata.version(package).split("+", 1)[0]
    assert actual == expected, (package, actual, expected)
assert torch.version.cuda == os.environ["EXPECTED_CUDA"], torch.version.cuda
assert importlib.metadata.version("onnxruntime-gpu") == os.environ["EXPECTED_ONNXRUNTIME"]
assert "CUDAExecutionProvider" in onnxruntime.get_available_providers()
assert f"{sys.version_info.major}.{sys.version_info.minor}" == os.environ["EXPECTED_PYTHON"]
PY

RUN mkdir -p /opt/rx-met-env \
    && printf '%s\n' \
        "environment_role=runtime" \
        "environment_version=${ENV_VERSION}" \
        "cuda_variant=${CUDA_VARIANT}" \
        "cuda_version=${RX_MET_CUDA_VERSION}" \
        "torch_version=${TORCH_VERSION}" \
        "onnxruntime_version=${ONNXRUNTIME_VERSION}" \
        "python_version=${PYTHON_VERSION}" \
        > /opt/rx-met-env/environment.env \
    && python3 -m pip freeze --all > /opt/rx-met-env/pip-freeze.txt \
    && dpkg-query --show > /opt/rx-met-env/dpkg-packages.txt

LABEL org.opencontainers.image.vendor="Reexen" \
      org.opencontainers.image.description="rx-met stable runtime environment" \
      com.reexen.rx-met.environment.role="runtime" \
      com.reexen.rx-met.environment.version="${ENV_VERSION}" \
      com.reexen.rx-met.cuda.variant="${CUDA_VARIANT}" \
      com.reexen.rx-met.cuda.version="${RX_MET_CUDA_VERSION}" \
      com.reexen.rx-met.torch.version="${TORCH_VERSION}" \
      com.reexen.rx-met.onnxruntime.version="${ONNXRUNTIME_VERSION}" \
      com.reexen.rx-met.python.version="${PYTHON_VERSION}"

CMD ["bash"]
